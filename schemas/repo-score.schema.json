{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/jankurai/schemas/repo-score.schema.json",
  "title": "Jankurai repo-score report",
  "description": "Attestation schema for the JSON report emitted by `jankurai audit` and uploaded by the hub CI audit/tool-adoption lanes as .jankurai/repo-score.json. This is the machine-readable proof artifact agents route off.",
  "type": "object",
  "required": ["score", "raw_score", "caps_applied", "decision", "findings"],
  "additionalProperties": true,
  "properties": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Final, cap-adjusted conformance score."
    },
    "raw_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Weighted dimension score before hard-rule caps."
    },
    "caps_applied": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Cap keys that limited the final score; empty when the repo passes cleanly."
    },
    "decision": {
      "type": "object",
      "required": ["status", "minimum_score", "passed", "hard_findings"],
      "additionalProperties": true,
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "minimum_score": { "type": "number" },
        "passed": { "type": "boolean" },
        "hard_findings": { "type": "integer", "minimum": 0 },
        "soft_findings": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "description": "Every audit finding with its typed repair surface.",
      "items": {
        "type": "object",
        "required": ["severity", "rule_id", "path"],
        "additionalProperties": true,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "rule_id": { "type": "string" },
          "path": { "type": "string" },
          "problem": { "type": "string" },
          "agent_fix": { "type": "string" },
          "rerun_command": { "type": "string" },
          "docs_url": { "type": "string" }
        }
      }
    }
  }
}
